<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.loop.loop-monitor</string>
    <key>ProgramArguments</key>
    <array>
        <string>__Loop_ROOT__/loop-monitor/run.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/loop-monitor.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/loop-monitor.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>__EXTRA_PATH__:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>BOUNTY_URL</key>
        <string>http://127.0.0.1:18792</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>__Loop_ROOT__/loop-monitor</string>
</dict>
</plist>
